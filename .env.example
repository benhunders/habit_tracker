# Server-side secrets (used by api/* serverless functions) — never use VITE_ prefix (would expose them to the browser)

# Anthropic API key — used by api/claude.js for the weekly review
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Lock the proxy to your deployed domain for security
# Leave as * for local dev, set to https://your-app.vercel.app in production
ALLOWED_ORIGIN=*
